# 官网 Compose 环境变量示例：复制为 website/.env 后按需填写（.env 已 gitignore）。
#
# 游玩数据接收端共享令牌（可选）。留空 = 不校验；非空时游戏端 `config/config.json` 的
# `telemetry_token`（或发布变量 SN_TELEMETRY_TOKEN）必须与其一致，否则接收端返回 401。
SN_TELEMETRY_TOKEN=

# Cloudflare Tunnel token（仅 docker compose --profile tunnel 需要）
CLOUDFLARE_TUNNEL_TOKEN=

# 宿主机端口（容器内固定 8080；默认 8088，避开常见的 8080 服务）
WEBSITE_PORT=8088

# 可选：覆盖本地镜像地址（默认 steam-navigator-website:local / steam-navigator-telemetry:local）
# WEBSITE_IMAGE=steam-navigator-website:local
# TELEMETRY_IMAGE=steam-navigator-telemetry:local

# 本地「游玩数据看板」宿主机端口（仅 `docker compose --profile dashboard up -d` 时启动，
# 只绑定 127.0.0.1，不发布到公网）。默认 8091。
TELEMETRY_DASHBOARD_PORT=8091
# TELEMETRY_DASHBOARD_IMAGE=steam-navigator-telemetry-dashboard:local

# 数据说明：接收端数据固定写在容器内 /data，由 Compose 命名卷
# steam-navigator-website_telemetry-data 持久化；结构为
#   /data/sessions/<YYYY-MM-DD>/<session_id>.json   原始游玩会话（紧凑 JSON）
#   /data/sessions/<YYYY-MM-DD>/index.ndjson        每行一条摘要（session_id / received_at / 计数）
# 保留 180 天（每小时至多一次惰性清理）。备份 / 迁移命令见 website/README.md「游玩数据接收端」。
# 不要在 .env 里改 SN_TELEMETRY_DATA_DIR：容器内路径与数据卷都按 /data 约定。
