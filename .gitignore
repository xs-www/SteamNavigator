# Godot 4 generated data
.godot/
*.translation
*.import
*.uid
export.cfg
# Godot's glTF importer extracts embedded textures next to the .glb
# (<glb basename>_<image name>.png). They are regenerated by `--import`, and the
# authored source is docs/design/textures/iron_harbor/tiles/ — never commit them.
dev_mods/core/assets/models/props/SN_HT_*.png

# Local build artifacts
dist/mods/*.zip
!dist/mods/.gitkeep
dist/build/
dist/release/
# Local updater end-to-end fixture (export, fake release, installs)
dist/e2e*/
*.tmp
*.log

# Local editor / OS files
.DS_Store
Thumbs.db
desktop.ini

# Python 工具脚本的缓存（tools/modeling/generators 现在入库）
__pycache__/
*.pyc

# Local art direction prototypes
.design/

# Test output
user_data/
test_output/
/tmp/
docs/design/screenshots/

*.zip
SNBattleSim/user_data/*.json
SNBattleSim/user_data/*.tmp

# Local release staging
/release/

# Agent worktrees / local coordination (never project content)
.agents/

# Website deployment secrets
website/.env
website/.env.*
!website/.env.example

website/.data/

