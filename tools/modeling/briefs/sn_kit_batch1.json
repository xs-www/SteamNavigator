{
  "id": "sn_kit_batch1",
  "title": "模型素材库 P0：武器套件（火炮/炮架/炮塔/武器基座）+ 船体部件（甲板/桅杆/烟囱/货舱盖）",
  "purpose": "建立可长期复用的模块化模型素材库：8 件可单独摆放、也可按 socket 契约互相拼装的低模资产，供后续搭船、搭港口场景与战斗演出使用。纯资产交付，不接游戏逻辑、不登记 manifest。",
  "category": "kit",
  "approved_by_human": true,
  "approved_note": "用户 2026-10-21 指定 P0 两组：weapon_kit（火炮、炮架、炮塔、武器基座）与 ship_parts（甲板、桅杆、烟囱、货舱盖），要求做成后续搭建用的模型素材库。",
  "style": {
    "look": "沿用铁甲舰/武器批次 1–2 的低模语言：木结构 + 铁板 + 黄铜机械件 + 深色玻璃；轮廓优先，四角 3/4 机位可辨认；共享贴图 SN_Tex_*，禁止纯色材质。",
    "palette": [
      "SN_Tex_Iron",
      "SN_Tex_Metal",
      "SN_Tex_Iron_Red",
      "SN_Tex_Wood",
      "SN_Tex_Wood_Dark",
      "SN_Tex_Wood_Deck",
      "SN_Tex_Brass",
      "SN_Tex_Glass_Dark",
      "SN_Tex_Canvas_Shade"
    ]
  },
  "scene_rules": {
    "single_writer": true,
    "do_not_modify": [
      "Camera",
      "DBG2_CAM",
      "Light",
      "SN_Ship_Root",
      "SN_Harbor_Town",
      "SN_Iron_Harbor_Architecture",
      "SN_IronHarbor_Props",
      "SN_Ship_Modules",
      "SN_Port_Facilities",
      "SN_Weapon_*",
      "SN_PF_Root",
      "SN_SF_Root",
      "SN_Ironclad"
    ],
    "no_delete": true,
    "no_save": true,
    "no_export": true,
    "no_new_camera_or_light": true,
    "no_text": true,
    "scene": ".design/SN_Asset_Workbench.blend"
  },
  "common": {
    "units": "1 unit = 1 m",
    "up_axis": "+Z",
    "forward_axis": "+X",
    "shading": "flat shading；共享贴图材质（SN_Tex_*）+ 世界空间盒式 UV",
    "conventions": "几何由生成器参数表驱动；闭合件边界边/非流形边/退化面必须为 0；Mount/Socket 为空节点，不参与几何。",
    "datums": "每件资产提供 SN_<Asset>_Mount 空节点作为装配挂点。地面类部件（炮架/炮塔/基座/甲板/桅杆/烟囱/货舱盖）Mount 在根 (0,0,0)，zmin=0；火炮是俯仰子件，根 = 耳轴轴心（Mount 在原点），炮架提供 SN_Weapon_GunCarriage_Trunnion_L/R 接收。",
    "material_rule": "新资产必须使用共享贴图材质 SN_Tex_*，干跑与 GLB 自检都按白名单核对；贴图外部化为 shared_materials/<texture>.png。"
  },
  "kit_contract": {
    "families": {
      "weapon_kit": "舰载武器可拼装件：火炮（炮管总成）、炮架（轮式炮车）、炮塔（装甲回转炮塔）、武器基座（甲板基座/回转环）。",
      "ship_parts": "船体可拼装件：甲板模块、桅杆总成、蒸汽烟囱、货舱盖。"
    },
    "mount_frame": "每件资产根下提供 SN_<Asset>_Mount（+X 前向、Z 向上）。装配只对齐 Root/Mount，不对齐具体 mesh。",
    "deck_module": "甲板是母模块，提供 SN_ShipPart_Deck_Socket_Mast / _Socket_Funnel / _Socket_Hatch / _Socket_Weapon_Port / _Socket_Weapon_Starboard 空节点；子件 Root 直接落到 socket。",
    "weapon_assembly": "火炮 Root → 炮架 Trunnion_L/R（火炮根 z=0.62 落在炮架耳轴高度）；炮塔/基座整件落到甲板或甲板 socket；所有武器件共享 mount_class / footprint / height 根属性。",
    "sockets": "所有接口都是空节点，命名固定为 SN_<Asset>_<Role>（Mount / Trunnion_L / Trunnion_R / Socket_* / Exhaust / Hinge_* / Top / Collar）。",
    "catalog": "docs/design/KIT_ASSET_LIBRARY.md 是素材库目录与装配配方；GLB 根节点 extras 写入 kit_family / part_role / mount_class / footprint / height 等机器可读字段。"
  },
