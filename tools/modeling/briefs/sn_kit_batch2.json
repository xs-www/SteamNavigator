{
  "id": "sn_kit_batch2",
  "title": "模型素材库批次 2（P1）：machinery_kit + cargo_kit + dock_kit",
  "purpose": "在批次 1（武器套件 + 船体部件）之后继续补 P1 模块：机械（齿轮组/卷扬机/动力装置）、货物（货箱/煤斗/储罐/托盘）、码头（码头结构/栈桥/系缆设施）。10 件资产沿用同一套 Mount + 语义 socket + 根 extras 契约，可独立摆放或互相拼装，供后续搭港口、船舱与场景使用。",
  "category": "kit",
  "approved_by_human": true,
  "approved_note": "用户 2026-10-21 指定 P1 三组：machinery_kit 齿轮、卷扬机、动力装置；cargo_kit 货箱、煤斗、储罐、托盘；dock_kit 码头结构、栈桥、系缆设施。要求作为后续搭建的模型素材库。",
  "style": {
    "look": "与批次 1 同一套低模语言：铸铁/铁板 + 木材 + 黄铜机械件 + 深色玻璃；轮廓优先；共享贴图 SN_Tex_*，禁止纯色材质。码头件用石材；煤斗新增 SN_Tex_Coal 碎煤贴图。",
    "palette": [
      "SN_Tex_Iron",
      "SN_Tex_Metal",
      "SN_Tex_Iron_Red",
      "SN_Tex_Wood",
      "SN_Tex_Wood_Dark",
      "SN_Tex_Wood_Deck",
      "SN_Tex_Brass",
      "SN_Tex_Glass_Dark",
      "SN_Tex_Canvas_Shade",
      "SN_Tex_Stone",
      "SN_Tex_Coal"
    ]
  },
  "scene_rules": {
    "single_writer": true,
    "do_not_modify": [
      "Camera",
      "DBG2_CAM",
      "Light",
      "SN_Ship_Root",
      "SN_Harbor_Town",
      "SN_Iron_Harbor_Architecture",
      "SN_IronHarbor_Props",
      "SN_Ship_Modules",
      "SN_Port_Facilities",
      "SN_Weapon_*",
      "SN_ShipPart_*",
      "SN_PF_Root",
      "SN_SF_Root",
      "SN_Ironclad"
    ],
    "no_delete": true,
    "no_save": true,
    "no_export": true,
    "no_new_camera_or_light": true,
    "no_text": true,
    "scene": ".design/SN_Asset_Workbench.blend"
  },
  "common": {
    "units": "1 unit = 1 m",
    "up_axis": "+Z",
    "forward_axis": "+X",
    "shading": "flat shading；共享贴图材质（SN_Tex_*）+ 世界空间盒式 UV",
    "conventions": "几何由生成器参数表驱动；闭合件边界边/非流形边/退化面必须为 0；Mount/Socket 为空节点，不参与几何。",
    "datums": "machinery/cargo 与 dock 系缆设施：根在底面/安装面中心，zmin=0；码头结构与栈桥：根在水线 z=0（栈桥桩可伸到水下，zmin=-1.30），+Y 朝水域。",
    "material_rule": "新资产必须使用共享贴图材质 SN_Tex_*；煤斗/煤堆使用新增的 SN_Tex_Coal（512² 无缝碎煤贴图）。"
  },
  "kit_contract": {
    "families": {
      "machinery_kit": "机械可拼装件：齿轮组（动力分配）、卷扬机（拉索/起重）、动力装置（蒸汽机 + 飞轮输出）。",
      "cargo_kit": "货物可拼装件：货箱（可堆叠）、煤斗（燃料转运）、储罐（液体/气体储存）、托盘（堆码底座）。",
      "dock_kit": "码头可拼装件：码头结构（8.4×4.2 m 岸壁模块）、栈桥（8×2.6 m 木栈桥模块）、系缆设施（双柱缆桩 + 系缆环 + 绳圈）。"
    },
    "mount_frame": "每件资产根下提供 SN_<Asset>_Mount（+X 前向、Z 向上）。装配只对齐 Root/Mount。",
    "machinery_chain": "动力装置 Shaft_Out（飞轮轴，+Y 轴向）→ 齿轮组 Shaft_In → 齿轮组 Shaft_Out / Crank；卷扬机 Drum_Pivot 接绳索，Rope_Out 为出绳点。",
    "dock_chain": "码头结构 Module_Next/Prev 沿 X 平铺；Socket_Mooring_1/2 接收系缆设施；Socket_Jetty 接收栈桥；栈桥 Module_Next/Prev 继续沿 X 平铺。",
    "console": "Root extras 写 kit_family / part_role / datum / mount_frame / base_footprint_x/y / envelope_x/y / height / tri_budget / bbox_target；模块化件另写 module_x/module_y。",
    "catalog": "docs/design/KIT_ASSET_LIBRARY.md 增加批次 2 目录与装配配方；GLB 根节点 extras 保留机器可读字段。"
  },
