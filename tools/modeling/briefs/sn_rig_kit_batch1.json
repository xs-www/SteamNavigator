{
  "id": "sn_rig_kit_batch1",
  "title": "M0-4 船体部件库 rig_kit：12 件 SN_Rig_* 帆索套件 + 3 艘船参数化替换",
  "purpose": "把 3 艘船焊死的桅杆 / 横桁 / 斜桁 / 帆杠 / 艏斜桁 / 帆面 / 索具收敛成参数化部件库；独立交付 12 件可拼装 SN_Rig_* 资产，并让 PF/SF/IC 从同一份 rig_kit 源码生成（几何逐位不变）。",
  "category": "kit",
  "approved_by_human": true,
  "approved_note": "用户 2026-10-22 选择 A：套件 + 3 艘船改用部件库（逐对象几何 digest 不变）；运行时 ShipVisualAssembler 本批不实现，只交付 assets + manifest + 契约。",
  "style": {
    "look": "沿用船体低模语言：木桅/木桁 + 铁箍/黄铜件 + 帆布单层双面；轮廓优先，3/4 视角可辨认。",
    "palette": [
      "SN_Tex_Wood",
      "SN_Tex_Wood_Dark",
      "SN_Tex_Wood_Deck",
      "SN_Tex_Metal",
      "SN_Tex_Iron",
      "SN_Tex_Brass",
      "SN_Tex_Canvas_Shade"
    ]
  },
  "scene_rules": {
    "single_writer": true,
    "no_delete": true,
    "no_save": true,
    "no_export": true,
    "no_new_camera_or_light": true,
    "do_not_modify": [
      "Camera",
      "DBG2_CAM",
      "Light",
      "SN_Ship_Root",
      "SN_Harbor_Town",
