{
  "id": "sn_kit_batch3",
  "title": "模型素材库批次 3（P2）：architecture_kit + environment_kit",
  "purpose": "在批次 2（机械 / 货物 / 码头）之后补 P2 场景模块：建筑（仓库 / 工坊 / 酒馆 / 厂房）与环境（礁石 / 残骸 / 灯塔 / 航标浮标）。8 件资产沿用批次 1–2 的 Mount + 语义 socket + 根 extras 契约，按 4 m 网格拼装：建筑沿 X 平铺、门口 / 吊点 / 烟囱等接口外露；环境件根在水线，可单独成景或互相落座（灯塔落在礁石 Top、残骸倚靠礁石）。",
  "category": "kit",
  "approved_by_human": true,
  "approved_note": "用户 2026-10-21 指定 P2 两组：architecture_kit 仓库、工坊、酒馆、厂房；environment_kit 礁石、残骸、灯塔等。要求作为后续搭建的模型素材库。",
  "style": {
    "look": "与批次 1–2 同一套低模语言：石基座 + 铁板/木材 + 黄铜机械件 + 深色玻璃；轮廓优先；共享贴图 SN_Tex_*，禁止纯色材质。建筑是‘可拼装的体量 + 立面节奏’，不做室内；环境件用石材 / 朽木 / 锈铁，保持风化轮廓。",
    "palette": [
      "SN_Tex_Iron",
      "SN_Tex_Metal",
      "SN_Tex_Iron_Red",
      "SN_Tex_Wood",
      "SN_Tex_Wood_Dark",
      "SN_Tex_Wood_Deck",
      "SN_Tex_Brass",
      "SN_Tex_Glass_Dark",
      "SN_Tex_Canvas_Shade",
      "SN_Tex_Stone"
    ]
  },
  "scene_rules": {
    "single_writer": true,
    "do_not_modify": [
      "Camera",
      "DBG2_CAM",
      "Light",
      "SN_Ship_Root",
      "SN_Harbor_Town",
      "SN_Iron_Harbor_Architecture",
      "SN_IronHarbor_Props",
      "SN_Ship_Modules",
      "SN_Port_Facilities",
      "SN_Weapon_*",
      "SN_ShipPart_*",
      "SN_Machinery_*",
      "SN_Cargo_*",
      "SN_Dock_*",
      "SN_PF_Root",
      "SN_SF_Root",
      "SN_Ironclad"
    ],
    "no_delete": true,
    "no_save": true,
    "no_export": true,
    "no_new_camera_or_light": true,
    "no_text": true,
    "scene": ".design/SN_Asset_Workbench.blend"
  },
  "common": {
    "units": "1 unit = 1 m",
    "up_axis": "+Z",
    "forward_axis": "+X",
    "shading": "flat shading；共享贴图材质（SN_Tex_*）+ 世界空间盒式 UV",
    "conventions": "几何由生成器参数表驱动；闭合件边界边/非流形边/退化面必须为 0；Mount/Socket 为空节点，不参与几何。",
    "datums": "建筑：根在建筑体量底面中心（zmin=0），+X 为正立面（门 / 雨棚 / 吊车），Module_Next/Prev 在体量 X 边 (±半长, 0, 0) 供平铺。环境：礁石 / 残骸 / 航标浮标根在水线 z=0（礁石到 z=-3.0、残骸船底到 z=-1.6、浮标吃水裙到 z=-0.7）；灯塔根在基座底面 z=0，由礁石 Top 接口托起。",
    "material_rule": "新资产必须使用共享贴图材质 SN_Tex_*；本批不新增贴图（沿用 11 张共享贴图）。"
  },
  "kit_contract": {
    "families": {
      "architecture_kit": "建筑可拼装件：仓库（大跨度 + 装卸雨棚）、工坊（外墙飞轮/皮带接口）、酒馆（两层 + 门廊 + 悬挑招牌）、厂房（锯齿采光顶 + 双烟囱 + 外置吊车梁）。",
      "environment_kit": "环境可拼装件：礁石群（水线上下 + 灯塔落座点）、沉船残骸（倾斜船壳/肋骨/断桅）、灯塔（石塔 + 环廊 + 灯室 + 透镜）、航标浮标（浮筒 + 灯架 + 钟 + 锚链）。"
    },
    "mount_frame": "每件资产根下提供 SN_<Asset>_Mount（+X 前向、Z 向上）。装配只对齐 Root/Mount。",
    "architecture_chain": "建筑 Module_Next/Module_Prev 沿 X 平铺（间距 = 体量 X 长）；Door_Front 为入口落点；仓库 Hoist 为雨棚吊点；工坊 Drive_Shaft 接 machinery_kit 动力装置飞轮轴；厂房 Gantry 为吊车梁吊点；Chimney 为烟柱 VFX 点。",
    "environment_chain": "礁石 Top 接收灯塔 / 残骸 Mount；灯塔 Lamp 为灯室光源点、Gallery 为环廊站位；残骸 Deck 为可站立甲板点、Mast 为断桅顶；浮标 Lamp/Bell/Chain 为灯、钟、锚链接口。",
    "console": "Root extras 写 kit_family / part_role / datum / mount_frame / base_footprint_x/y / envelope_x/y / height / tri_budget / bbox_target；建筑另写 module_x/module_y；环境件另写 waterline（相对根的水线高度，航标=0、礁石=0、残骸=0、灯塔=0）。",
    "catalog": "docs/design/KIT_ASSET_LIBRARY.md 增加批次 3 目录与装配配方；tools/modeling/kit_catalog.json 追加 8 件与配方；GLB 根节点 extras 保留机器可读字段。"
  },
