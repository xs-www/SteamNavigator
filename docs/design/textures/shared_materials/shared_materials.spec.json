{
  "id": "shared_materials_v1",
  "schema": "steam-navigator/shared-material-textures@1",
  "role": "通用共享材质贴图库：每张 512²、无缝平铺的 sRGB 贴图对应一个 SN_* 材质；模型只按材质名引用，贴图作为外部共享 PNG 随 core 模组发布，多件资产在 Godot 里共享同一个 Texture2D。",
  "tile_px": 512,
  "px_per_m": 256,
  "color_space": "sRGB",
  "seamless": true,
  "quantize_colors": 96,
  "art_direction": "低饱和维多利亚工业港：金属以拉丝/铸造麻点为主，锈红漆面有磨损露金属，木材顺纹带轻微色阶，石材错缝砌块，黄铜有氧化与高光，帆布是粗织纹，玻璃深色带一条柔和高光带。整体中低对比，避免高频噪点；贴图均值贴近原纯色调色板，换贴图后明度层级不变。 材质名使用 SN_Tex_* 前缀：旧资产的 SN_* 纯色材质保持不动，新资产共用贴图材质；旧资产完成 UV 迁移后再逐批切换。",
  "outputs": {
    "tiles": "docs/design/textures/shared_materials/tiles",
    "montage": "docs/design/textures/shared_materials/shared_materials_montage.png",
    "stats": "docs/design/textures/shared_materials/shared_materials.stats.json"
  },
  "runtime_dirs": [
    "assets/models/props/shared_materials",
    "dev_mods/core/assets/models/props/shared_materials",
    "assets/models/port/shared_materials",
    "dev_mods/core/assets/models/port/shared_materials",
    "assets/models/modules/shared_materials",
