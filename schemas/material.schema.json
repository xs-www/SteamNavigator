{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/material-1.json",
  "title": "Steam Navigator shipbuilding materials content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "materials"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/material_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "material_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "unit_weight", "base_price", "base_stock"],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "unit_weight": {
          "type": "number",
          "minimum": 0.1
        },
        "base_price": {
          "type": "number",
          "minimum": 1
        },
        "base_stock": {
          "type": "number",
          "minimum": 1
        },
        "price_elasticity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
