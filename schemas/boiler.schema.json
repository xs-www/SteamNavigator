{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/boiler-1.json",
  "title": "Steam Navigator boiler content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "boilers"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/boiler_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "boiler_data": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/module_common"
        },
        {
          "type": "object",
          "required": ["speed_mul", "coal_rate", "water_rate"],
          "properties": {
            "speed_mul": {
              "type": "number",
              "minimum": 0.2,
              "maximum": 3
            },
            "coal_rate": {
              "type": "number",
              "minimum": 0
            },
            "water_rate": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    }
  }
}
