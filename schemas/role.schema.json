{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/role-1.json",
  "title": "Steam Navigator crew role content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "roles"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/role_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "role_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "wage_per_voyage"],
      "properties": {
        "kind": {
          "enum": ["engineer", "navigator"]
        },
        "wage_per_voyage": {
          "type": "number",
          "minimum": 0
        },
        "hire_cost": {
          "type": "number",
          "minimum": 0
        },
        "modifiers": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/modifier"
          }
        }
      }
    }
  }
}
