{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/cargo-module-1.json",
  "title": "Steam Navigator cargo module content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "cargo_modules"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/cargo_module_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "cargo_module_data": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/module_common"
        },
        {
          "type": "object",
          "required": ["capacity"],
          "properties": {
            "capacity": {
              "type": "number",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
