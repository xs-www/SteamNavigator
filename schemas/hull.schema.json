{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/hull-1.json",
  "title": "Steam Navigator hull content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "hulls"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/hull_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "hull_data": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/module_common"
        },
        {
          "type": "object",
          "required": ["base_speed", "max_weight", "max_durability", "cargo_slots", "cabin_slots", "base_risk"],
          "properties": {
            "base_speed": {
              "type": "number",
              "minimum": 1
            },
            "max_weight": {
              "type": "number",
              "minimum": 1
            },
            "max_durability": {
              "type": "number",
              "minimum": 1
            },
            "cargo_slots": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "cabin_slots": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "base_risk": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "size_tag": {
              "enum": ["small", "medium", "large"]
            }
          }
        }
      ]
    }
  }
}
