{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/cabin-1.json",
  "title": "Steam Navigator passenger cabin content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "cabins"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/cabin_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "cabin_data": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/module_common"
        },
        {
          "type": "object",
          "required": ["passenger_capacity"],
          "properties": {
            "passenger_capacity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        }
      ]
    }
  }
}
