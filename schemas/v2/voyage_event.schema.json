{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/voyage-event-2.json",
  "title": "Steam Navigator voyage event content file (Content Schema 2.0)",
  "description": "Voyage events that fire during travel (C4): trigger, category, weight, optional condition and player options with effects. Successor of the 1.0 `events` content type; the data block is unchanged, the type, id segment and default file are renamed to voyage_events / core:voyage_event/* / content/voyage_events.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "voyage_events"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/voyage_event_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "option_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "effects"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "name_key": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "minimum": 0
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/condition_node"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/effect"
          }
        }
      }
    },
    "voyage_event_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "category", "options"],
      "properties": {
        "trigger": {
          "enum": ["voyage_risk", "voyage_opportunity"]
        },
        "category": {
          "enum": ["mechanical", "merchant"]
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "exclusiveMinimum": 0
        },
        "base_delay_hours": {
          "type": "number",
          "minimum": 0
        },
        "condition": {
          "$ref": "common.schema.json#/$defs/condition_node"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/option_data"
          }
        }
      }
    }
  }
}
