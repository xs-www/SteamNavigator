{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/common-2.json",
  "title": "Steam Navigator common content schema 2.0",
  "description": "Shared definitions for Content Schema 2.0 files. Uses only the subset supported by the project SchemaValidator.",
  "$defs": {
    "id_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}:[a-z_]+/[a-z0-9_]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name_key",
        "enabled",
        "data"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_ref"
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "information": {
          "$ref": "#/$defs/entity_information"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "entity_information": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "texture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "range2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "integer_range2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cargo_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "amount"
      ],
      "properties": {
        "item": {
          "$ref": "#/$defs/id_ref"
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tag_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "story_presentation": {
      "enum": [
        "card",
        "briefing",
        "debrief",
        "toast",
        "choice",
        "radio",
        "camera_hint"
      ]
    },
    "story_stage": {
      "$comment": "Shared by the tutorial map_config flow and Story Mode levels. Story Mode data contract v1 froze the shapes below on 2026-10-27 (see docs/specs/STORY_MODE_DATA_CONTRACT_V1.md).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "advance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "checkpoint": {
          "type": "boolean"
        },
        "presentation": {
          "$ref": "#/$defs/story_presentation"
        },
        "dialogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title_key",
            "body_keys"
          ],
          "properties": {
            "title_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "body_keys": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "unlock_features": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          }
        },
        "unlock_items": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/id_ref"
          }
        },
        "unlock_modules": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/id_ref"
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text_key",
            "target"
          ],
          "properties": {
            "text_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            }
          }
        },
        "advance": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "mode": {
              "enum": [
                "confirm"
              ]
            },
            "event": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "counter": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "counter_from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "at_least": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "flag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "not_flag": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/story_condition"
              }
            },
            "match": {
              "$ref": "#/$defs/story_match"
            }
          }
        },
        "lock_actions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          }
        },
        "preferred_strategy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target"
          ],
          "properties": {
            "target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "text_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        },
        "effects": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    "story_condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "counter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "counter_from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "at_least": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "flag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "not_flag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "match": {
          "$ref": "#/$defs/story_match"
        }
      }
    },
    "story_match": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stat",
        "op",
        "value"
      ],
      "properties": {
        "stat": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "op": {
          "enum": [
            "add",
            "mul",
            "set"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "condition_node": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "all": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/condition_node"
          }
        },
        "any": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/condition_node"
          }
        },
        "not": {
          "$ref": "#/$defs/condition_node"
        },
        "op": {
          "enum": [
            "money_gte",
            "reputation_gte",
            "debt_lte",
            "at_port",
            "port_has_tag",
            "has_item",
            "has_module",
            "has_module_tag",
            "has_role",
            "contract_completed",
            "port_discovered",
            "ship_tier_gte",
            "durability_gte"
          ]
        },
        "value": {},
        "tag": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "port_id": {
          "type": "string"
        },
        "role_kind": {
          "type": "string"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "add_money",
            "remove_money",
            "add_reputation",
            "remove_reputation",
            "add_item",
            "remove_item",
            "add_coal",
            "remove_coal",
            "add_water",
            "remove_water",
            "damage_ship",
            "repair_ship",
            "damage_module",
            "add_delay_hours",
            "damage_cargo",
            "injure_passenger",
            "unlock_definition",
            "complete_contract",
            "fail_voyage",
            "reveal_port_facilities",
            "update_intelligence",
            "emit_notice"
          ]
        },
        "amount": {
          "type": "number"
        },
        "id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "port_id": {
          "type": "string"
        },
        "text_key": {
          "type": "string"
        },
        "slot": {
          "type": "string",
          "pattern": "^(boiler|navigation|safety|cabin|cargo)$"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cargo",
            "passenger"
          ]
        },
        "name_key": {
          "type": "string"
        },
        "weight_range": {
          "$ref": "#/$defs/range2"
        },
        "count_range": {
          "$ref": "#/$defs/range2"
        },
        "provider": {
          "enum": [
            "player",
            "fuel"
          ]
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_money",
        "on_time_bonus",
        "reputation"
      ],
      "properties": {
        "base_money": {
          "$ref": "#/$defs/range2"
        },
        "on_time_bonus": {
          "$ref": "#/$defs/range2"
        },
        "reputation": {
          "type": "integer",
          "minimum": 0
        },
        "unlock_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id_ref"
          }
        }
      }
    }
  }
}
