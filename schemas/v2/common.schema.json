{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/common-2.json",
  "title": "Steam Navigator common content schema 2.0",
  "description": "Shared definitions for Content Schema 2.0 files. Uses only the subset supported by the project SchemaValidator.",
  "$defs": {
    "id_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}:[a-z_]+/[a-z0-9_]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "enabled", "data"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_ref"
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "information": {
          "$ref": "#/$defs/entity_information"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "entity_information": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "texture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "range2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "integer_range2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "cargo_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "amount"],
      "properties": {
        "item": {
          "$ref": "#/$defs/id_ref"
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tag_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    }
  }
}
