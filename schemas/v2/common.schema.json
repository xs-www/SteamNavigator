{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/common-2.json",
  "title": "Steam Navigator common content schema 2.0",
  "description": "Shared definitions for Content Schema 2.0 files. Uses only the subset supported by the project SchemaValidator.",
  "$defs": {
    "id_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}:[a-z_]+/[a-z0-9_]+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "enabled", "data"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id_ref"
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/tag"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "information": {
          "$ref": "#/$defs/entity_information"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "entity_information": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "texture": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "range2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "integer_range2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer"
      }
    },
    "cargo_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "amount"],
      "properties": {
        "item": {
          "$ref": "#/$defs/id_ref"
        },
        "amount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tag_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "story_presentation": {
      "enum": [
        "card",
        "briefing",
        "debrief",
        "toast",
        "choice",
        "radio",
        "camera_hint"
      ]
    },
    "story_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "advance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint": {
          "type": "boolean"
        },
        "presentation": {
          "$ref": "#/$defs/story_presentation"
        },
        "dialogue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title_key",
            "body_keys"
          ],
          "properties": {
            "title_key": {
              "type": "string",
              "minLength": 1
            },
            "body_keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "unlock_features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "unlock_items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id_ref"
          }
        },
        "unlock_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id_ref"
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text_key",
            "target"
          ],
          "properties": {
            "text_key": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "advance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "confirm"
              ]
            },
            "event": {
              "type": "string",
              "minLength": 1
            },
            "counter": {
              "type": "string",
              "minLength": 1
            },
            "counter_from": {
              "type": "string",
              "minLength": 1
            },
            "at_least": {
              "type": "integer",
              "minimum": 1
            },
            "flag": {
              "type": "string",
              "minLength": 1
            },
            "not_flag": {
              "type": "string",
              "minLength": 1
            },
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/story_condition"
              }
            },
            "match": {
              "$ref": "#/$defs/story_match"
            }
          }
        },
        "lock_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "preferred_strategy": {
          "type": "string",
          "minLength": 1
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "story_condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1
        },
        "counter": {
          "type": "string",
          "minLength": 1
        },
        "counter_from": {
          "type": "string",
          "minLength": 1
        },
        "at_least": {
          "type": "integer",
          "minimum": 1
        },
        "flag": {
          "type": "string",
          "minLength": 1
        },
        "not_flag": {
          "type": "string",
          "minLength": 1
        },
        "match": {
          "$ref": "#/$defs/story_match"
        }
      }
    },
    "story_match": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
