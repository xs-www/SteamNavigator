{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/hazard-table-2.json",
  "title": "Steam Navigator hazard table content file (Content Schema 2.0)",
  "description": "Ruin hazard tables (D5): weighted hazards with type, amount range and text. IDs use core:hazard_table/*.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "content_type": { "const": "hazard_tables" },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/definition" },
          { "type": "object", "properties": { "data": { "$ref": "#/$defs/hazard_table_data" } } }
        ]
      }
    }
  },
  "$defs": {
    "hazard_table_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "weight", "amount_range"],
            "properties": {
              "type": { "enum": ["durability", "money", "cargo"] },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
              "amount_range": { "$ref": "common.schema.json#/$defs/integer_range2" },
              "text_key": { "type": "string", "minLength": 1, "maxLength": 160 }
            }
          }
        }
      }
    }
  }
}
