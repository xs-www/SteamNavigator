{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/region-2.json",
  "title": "Steam Navigator region content file (Schema 2.0 draft)",
  "description": "World region prototype: kind, size, density budgets, weather and faction presence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "regions"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/region_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "region_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "size", "port_density", "site_density", "weather_profile", "region_tags"],
      "properties": {
        "kind": {
          "enum": ["coastal", "archipelago", "open_sea", "industrial", "frontier"]
        },
        "size": {
          "enum": ["small", "medium", "large"]
        },
        "port_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "site_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hostile_density": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weather_profile": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "factions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id_ref"
          }
        },
        "region_tags": {
          "$ref": "common.schema.json#/$defs/tag_list"
        }
      }
    }
  }
}
