{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/site-2.json",
  "title": "Steam Navigator site content file (Schema 2.0 draft)",
  "description": "Discoverable world site prototype (ruins, base sites, resources, wrecks, landmarks, encounters).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "sites"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/site_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "site_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_kind", "weight"],
      "properties": {
        "site_kind": {
          "enum": ["ruin", "base_site", "resource", "wreck", "landmark", "encounter"]
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "region_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["coastal", "archipelago", "open_sea", "industrial", "frontier"]
          }
        },
        "ruin_archetype": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "encounter_table": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "loot_table": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "repeatable": {
          "type": "boolean"
        }
      }
    }
  }
}
