{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/story-arc-2.json",
  "title": "Steam Navigator story arc content file (Schema 2.0; Story Mode data contract v1, frozen)",
  "description": "Story Mode campaign arcs. One arc is one playable story campaign inside a story-only content mod: a fixed protagonist, the cast and glossary authored from the World Forge world bible, and the ordered level list. The data contract is frozen (2026-10-27); see docs/specs/STORY_MODE_DATA_CONTRACT_V1.md for the constraint list. Runtime loading lands with Story Mode S2; until then the type stays a draft type and the Godot runtime rejects it as inactive.",
  "$comment": "Story Mode data contract v1 — frozen 2026-10-27. Breaking structural changes require a new contract version (see docs/specs/STORY_MODE_DATA_CONTRACT_V1.md §7).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "story_arcs"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/story_arc_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "local_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "story_character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key"],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "role": {
          "enum": ["protagonist", "supporting", "antagonist", "other"]
        }
      }
    },
    "story_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "term_key", "definition_key"],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "term_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "definition_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "story_arc_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protagonist_id", "characters", "levels"],
      "properties": {
        "protagonist_id": {
          "$ref": "#/$defs/local_id"
        },
        "characters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/story_character"
          }
        },
        "terms": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/story_term"
          }
        },
        "levels": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/id_ref"
          }
        },
        "canon": {
          "type": "boolean"
        },
        "completion_achievement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{1,63}$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "world_bible": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      }
    }
  }
}
