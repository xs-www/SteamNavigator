{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/port-template-2.json",
  "title": "Steam Navigator port template content file (Content Schema 2.0)",
  "description": "Generated-port template (C4): size, facilities and market stock table. Successor of the 1.0 port_archetype content type; the data block is unchanged, the type, id segment and default file are renamed to port_templates / core:port_template/* / content/port_templates.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "port_templates"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/port_template_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "port_template_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "facilities", "market"],
      "properties": {
        "size": {
          "enum": ["small", "medium", "large"]
        },
        "facilities": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["exchange", "contracts", "supply", "shipyard", "tavern", "intel"]
          }
        },
        "banner_asset": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "diorama": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kit": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "density": {
              "enum": ["sparse", "normal", "busy"]
            },
            "town": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              }
            },
            "facility_visuals": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]*$"
              }
            },
            "palette": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "landmark": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            }
          }
        },
        "market": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["good", "stock_range"],
            "properties": {
              "good": {
                "$ref": "common.schema.json#/$defs/id_ref"
              },
              "stock_range": {
                "$ref": "common.schema.json#/$defs/range2"
              },
              "price_bias": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              }
            }
          }
        }
      }
    }
  }
}
