{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/story-level-2.json",
  "title": "Steam Navigator story level content file (Story Mode data contract v2, draft)",
  "description": "Story Mode levels (data contract v2 draft). One level is one hand-authored mission: hand-written landmasses and route paths, the initial run state, visible system limits, staged narrative (2D lines/choices/focus) and task definitions, plus triggers, difficulty knobs, checkpoint retry policy and non-gameplay rewards. See docs/specs/STORY_MODE_DATA_CONTRACT_V2.md. Runtime loading lands with Story Mode S2; until then the type stays a draft type and the Godot runtime rejects it as inactive.",
  "$comment": "Story Mode data contract v2 (draft 2026-10-27). Supersedes v1 before any content ships; breaking changes follow docs/specs/STORY_MODE_DATA_CONTRACT_V2.md §14.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "story_levels"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/story_level_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "local_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "port_id": {
      "type": "string",
      "pattern": "^port_[0-9]{1,2}$"
    },
    "story_position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 4096
      }
    },
    "landmass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "polygon"],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "kind": {
          "enum": ["island", "continent", "reef"]
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "polygon": {
          "type": "array",
          "minItems": 3,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/story_position"
          }
        }
      }
    },
    "market_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "stock", "price"],
      "properties": {
        "item": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "stock": {
          "type": "number",
          "minimum": 0
        },
        "price": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fixed_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "position"],
      "properties": {
        "id": {
          "$ref": "#/$defs/port_id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "archetype": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "position": {
          "$ref": "#/$defs/story_position"
        },
        "facilities": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$"
          }
        },
        "market": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/market_entry"
          }
        }
      }
    },
    "route_path": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/story_position"
      }
    },
    "fixed_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "path", "risk"],
      "properties": {
        "from": {
          "$ref": "#/$defs/port_id"
        },
        "to": {
          "$ref": "#/$defs/port_id"
        },
        "path": {
          "$ref": "#/$defs/route_path"
        },
        "risk": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bidirectional": {
          "type": "boolean"
        }
      }
    },
    "fixed_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landmasses", "ports", "edges", "start_port"],
      "properties": {
        "landmasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/landmass"
          }
        },
        "ports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/fixed_port"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/fixed_edge"
          }
        },
        "start_port": {
          "$ref": "#/$defs/port_id"
        }
      }
    },
    "level_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed"],
      "properties": {
        "fog": {
          "enum": ["revealed", "explored", "unknown"]
        },
        "revealed_ports": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/port_id"
          }
        },
        "map_config": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "fixed": {
          "$ref": "#/$defs/fixed_map"
        }
      }
    },
    "route_pair": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/port_id"
      }
    },
    "level_start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starting_scenario"],
      "properties": {
        "starting_scenario": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "port_id": {
          "$ref": "#/$defs/port_id"
        },
        "money": {
          "type": "number",
          "minimum": 0
        },
        "ship_fuel": {
          "type": "number",
          "minimum": 0
        },
        "ship_water": {
          "type": "number",
          "minimum": 0
        },
        "cargo": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/cargo_stack"
          }
        },
        "equipped_modules": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/id_ref"
          }
        },
        "world_time": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "route_access": {
          "enum": ["all", "none", "listed"]
        },
        "unlocked_routes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/route_pair"
          }
        }
      }
    },
    "task_objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "counter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "at_least": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "match": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "text_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "task_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title_key", "objectives"],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "title_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/task_objective"
          }
        }
      }
    },
    "task_tracking": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "task_rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money": {
          "type": "number",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/cargo_stack"
          }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          }
        }
      }
    },
    "story_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name_key", "kind", "stages"],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "name_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "kind": {
          "enum": ["story", "guide", "system"]
        },
        "auto_start": {
          "type": "boolean"
        },
        "tracking": {
          "$ref": "#/$defs/task_tracking"
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/task_stage"
          }
        },
        "rewards": {
          "$ref": "#/$defs/task_rewards"
        },
        "deadline_hours": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "story_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "effects"],
      "properties": {
        "id": {
          "$ref": "#/$defs/local_id"
        },
        "once": {
          "type": "boolean"
        },
        "when": {
          "$ref": "common.schema.json#/$defs/story_condition"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "common.schema.json#/$defs/story_effect"
          }
        }
      }
    },
    "level_difficulty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "enum": ["story.intro", "story.standard", "story.hard"]
        },
        "knobs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "starting_money_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "deadline_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "risk_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "coal_water_scale": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "hint_level": {
              "enum": ["full", "light", "none"]
            }
          }
        }
      }
    },
    "level_rewards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "achievements": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{1,63}$"
          }
        },
        "codex_entries": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{1,63}$"
          }
        },
        "cosmetics": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{1,63}$"
          }
        }
      }
    },
    "level_fail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_mode", "allow"],
      "properties": {
        "default_mode": {
          "enum": ["checkpoint", "level_start"]
        },
        "allow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["checkpoint", "level_start"]
          }
        },
        "failure_title_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "failure_keys": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        }
      }
    },
    "story_level_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "start", "stages"],
      "properties": {
        "map": {
          "$ref": "#/$defs/level_map"
        },
        "start": {
          "$ref": "#/$defs/level_start"
        },
        "access": {
          "$ref": "common.schema.json#/$defs/story_access"
        },
        "tasks": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/story_task"
          }
        },
        "triggers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/story_trigger"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "common.schema.json#/$defs/story_stage"
          }
        },
        "difficulty": {
          "$ref": "#/$defs/level_difficulty"
        },
        "rewards": {
          "$ref": "#/$defs/level_rewards"
        },
        "fail": {
          "$ref": "#/$defs/level_fail"
        }
      }
    }
  }
}
