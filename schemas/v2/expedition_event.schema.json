{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/expedition-event-2.json",
  "title": "Steam Navigator expedition event content file (Content Schema 2.0)",
  "description": "Ruin expedition events (D5): prompt, 1-3 options and their effect ops. IDs use core:expedition_event/*.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "content_type": { "const": "expedition_events" },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/definition" },
          { "type": "object", "properties": { "data": { "$ref": "#/$defs/expedition_event_data" } } }
        ]
      }
    }
  },
  "$defs": {
    "expedition_event_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_key", "options"],
      "properties": {
        "text_key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text_key", "effect"],
            "properties": {
              "text_key": { "type": "string", "minLength": 1, "maxLength": 160 },
              "name_key": { "type": "string", "minLength": 1, "maxLength": 160 },
              "effect": { "$ref": "common.schema.json#/$defs/effect" }
            }
          }
        }
      }
    }
  }
}
