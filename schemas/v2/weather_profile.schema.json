{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/weather-profile-2.json",
  "title": "Steam Navigator weather profile content file (Content Schema 2.0)",
  "description": "Climate band prototype: fog/storm/ice chances and voyage modifiers applied while a ship travels through a region.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "content_type": {
      "const": "weather_profiles"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/weather_profile_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "weather_profile_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["climate", "fog_chance", "storm_chance", "risk_modifier"],
      "properties": {
        "climate": {
          "enum": ["temperate", "cold", "tropical", "volcanic", "storm_belt"]
        },
        "fog_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "storm_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ice_chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "base_visibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "risk_modifier": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "speed_modifier": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "coal_drain_modifier": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "seasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["spring", "summer", "autumn", "winter"]
          }
        }
      }
    }
  }
}
