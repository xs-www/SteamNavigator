{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/relic-2.json",
  "title": "Steam Navigator relic content file (Content Schema 2.0)",
  "description": "Ruin relics (D5): rarity, passive modifiers and optional value. IDs use core:relic/*.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "content_type": { "const": "relics" },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "common.schema.json#/$defs/definition" },
          { "type": "object", "properties": { "data": { "$ref": "#/$defs/relic_data" } } }
        ]
      }
    }
  },
  "$defs": {
    "relic_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rarity", "value"],
      "properties": {
        "rarity": { "enum": ["common", "rare", "legendary"] },
        "value": { "type": "number", "minimum": 0, "maximum": 100000 },
        "modifiers": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "common.schema.json#/$defs/modifier" }
        }
      }
    }
  }
}
