{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/port-archetype-1.json",
  "title": "Steam Navigator port archetype content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "port_archetypes"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/port_archetype_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "port_archetype_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "facilities", "market"],
      "properties": {
        "size": {
          "enum": ["small", "medium", "large"]
        },
        "facilities": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": ["exchange", "contracts", "supply", "shipyard", "intel"]
          }
        },
        "market": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["good", "stock_range"],
            "properties": {
              "good": {
                "$ref": "common.schema.json#/$defs/id_ref"
              },
              "stock_range": {
                "$ref": "common.schema.json#/$defs/range2"
              },
              "price_bias": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 2
              }
            }
          }
        }
      }
    }
  }
}
