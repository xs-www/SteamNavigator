{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://steam-navigator.local/schema/starting-build-1.json",
  "title": "Steam Navigator starting build content file",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_type", "definitions"],
  "properties": {
    "schema_version": {
      "enum": ["1.0"]
    },
    "content_type": {
      "const": "starting_builds"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/definition"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/$defs/starting_build_data"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "starting_build_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["money", "reputation", "hull", "boiler", "cargo_modules", "coal", "water"],
      "properties": {
        "money": {
          "type": "number",
          "minimum": 0
        },
        "reputation": {
          "type": "integer",
          "minimum": 0
        },
        "hull": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "boiler": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "cargo_modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/id_ref"
          }
        },
        "navigation_module": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "safety_module": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "passenger_cabin": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "engineer": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "navigator": {
          "$ref": "common.schema.json#/$defs/id_ref"
        },
        "coal": {
          "type": "number",
          "minimum": 0
        },
        "water": {
          "type": "number",
          "minimum": 0
        },
        "durability_ratio": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1
        },
        "loan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal", "interest_rate", "term_hours"],
          "properties": {
            "principal": {
              "type": "number",
              "minimum": 1
            },
            "interest_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.5
            },
            "term_hours": {
              "type": "number",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
